<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>HK Feeds — Curation System</title>
  </head>
  <body>
    <!-- English-language HK press -->
    <outline text="Hong Kong Free Press" title="Hong Kong Free Press" type="rss" xmlUrl="https://www.hongkongfp.com/feed/"/>
    <outline text="SCMP" title="SCMP" type="rss" xmlUrl="https://www.scmp.com/rssfeed/"/>
    <outline text="The Standard" title="The Standard" type="rss" xmlUrl="https://www.thestandard.com.hk/rss/"/>
    <!-- Chinese-language HK press -->
    <outline text="Headline Daily" title="Headline Daily" type="rss" xmlUrl="https://www.hket.com/rss/"/>
    <outline text="Ming Pao" title="Ming Pao" type="rss" xmlUrl="https://news.mingpao.com/rss/p02.xml"/>
    <outline text="Oriental Daily" title="Oriental Daily" type="rss" xmlUrl="https://orientaldaily.on.cc/rss/news.xml"/>
    <outline text="Sing Tao Daily" title="Sing Tao Daily" type="rss" xmlUrl="https://www.singtao.com/feed/news.xml"/>
    <!-- Government / statutory -->
    <outline text="RTHK" title="RTHK News" type="rss" xmlUrl="https://news.rthk.hk/rthk/news/rss.htm"/>
    <outline text="InfoGov HK" title="Information Services Department" type="rss" xmlUrl="https://www.gov.hk/en/about/rss/index.xml"/>
    <!-- China-focused -->
    <outline text=" CDT News" title="China Digital Times" type="rss" xmlUrl="https://chinadigitaltimes.net/feed/"/>
    <outline text="SupChina" title="SupChina" type="rss" xmlUrl="https://www.supchina.com/feed/"/>
  </body>
</opml>